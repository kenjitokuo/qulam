cabal-version:       2.2

name:                qulam-compiler
version:             0.1.0.0
-- synopsis:
-- description:
homepage:            https://github.com/kenjitokuo/qulam#readme
license:             BSD-3-Clause
license-file:        LICENSE
author:              Kenji Tokuo
maintainer:          55696368+kenjitokuo@users.noreply.github.com
copyright:           2026 Kenji Tokuo
category:            Language
build-type:          Simple
extra-source-files:  README.md
                     CHANGELOG.md

executable qulam-compiler
  hs-source-dirs:      src
  other-modules:
                       QuLam.Syntax,
                       QuLam.Parser
  main-is:             Main.hs
  default-language:    Haskell2010
  build-depends:       base >= 4.7 && < 5,
                       megaparsec
  ghc-options:         -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-record-updates
                       -Wincomplete-uni-patterns
                       -Wmissing-export-lists
                       -Wmissing-home-modules
                       -Wpartial-fields
                       -Wredundant-constraints

source-repository head
  type:     git
  location: https://github.com/kenjitokuo/qulam
